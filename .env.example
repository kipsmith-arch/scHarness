# scHarness project configuration — HARNESS-LEVEL ONLY.
#
# `harness/config.py` auto-loads this `.env.example` (and the project-root
# `.env` if present) into os.environ. Priority: CLI flag > env var > hardcoded
# default. Disable: `export SC_HARNESS_SKIP_DOTENV=1`.
#
# Skill-level configuration (e.g. cell-annotation's Neo4j credentials, KG
# query parameters, gene-mapping file path) lives in the skill's own directory:
#     skills/cell-annotation/.env.example   (copy to .env and edit)
# loaded by `skills/cell-annotation/scripts/common.py`. The harness does not
# know what external services any skill depends on.
#
# Canonical schema lives in docs/CONFIGURATION_REFERENCE.md §2 / §3.0.
# Keep this file, `harness/config.py:RECOGNIZED_KEYS`, and the docs in sync.

# ─── OpenAI-compatible LLM gateway ───────────────────────────────────────
# Consumed by harness/session.py:build_llm(). API key / base URL have no
# safe default — leave empty to fall back to the gateway's default credential.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=6

# ─── Notebook / RAG ──────────────────────────────────────────────────────
# RAG_NOTES_DIR: directory holding notes.jsonl + notes_chroma/. Default =
# <project-dir>/notes.jsonl alongside the conversation.
# RAG_NOTES_DIR=
#
# RAG_EMBEDDING: embedding mode. Accepted values:
#   (unset) / "" / "local"       local sentence-transformers + Chroma (default)
#   "local:<model>"              named local model + Chroma
#   "off" / "none" / "bm25"      disable embeddings, BM25 fallback only
#   <anything-else>              treat as a bare model name (online download
#                                attempted only when not cached locally)
# RAG_EMBEDDING=