# cell-annotation skill configuration (template — copy to .env and edit).
#
# `skills/cell-annotation/scripts/common.py:load_skill_dotenv()` auto-loads
# this `.env.example` (and the skill's own `.env` if present) into os.environ
# at import time. Priority: shell env > .env > .env.example.
# Disable: `export CELL_ANNOTATION_SKIP_DOTENV=1`.
#
# SCOPE: Neo4j credentials + BLAST subject-library / query-FASTA paths.
# The harness does not know these keys exist (it only owns loop-level config:
# LLM gateway, RAG toggles). Skill-level KG query parameters (--species-type,
# --min-confidence, --max-ancestor-hops) are LLM-facing argparse parameters;
# they are NOT here. Gene ID mapping (TAIR locus → symbol etc.) was removed
# from the skill — it is a data-processing responsibility handled upstream.
#
# Recognized keys: `common.SKILL_DOTENV_KEYS` in skills/cell-annotation/scripts/common.py.

# ─── Neo4j / knowledge graph ──────────────────────────────────────────────
# Required by step3c_kg (KG queries) and scripts/build_label_map.py. Password
# has no default — the skill refuses to connect without one.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# ─── BLASTP subject library (only used when --provider blastp) ────────────
# Zip is fetched on first blastp call if the local cache is missing. Do not
# commit the unzipped DB. HEAD on this URL returns 404; the skill uses GET.
CELL_ANNOTATION_BLASTDB_DIR=
CELL_ANNOTATION_BLASTDB_URL=https://xener.dcs.cloud/api/public/download?file=blastdb.zip
# Hex digest of the current zip (44152397 bytes). Update URL + digest +
# references/reference-species.md together when the library is rebuilt.
CELL_ANNOTATION_BLASTDB_SHA256=8dd83c925f8f18d7e3f2cf626ce780548085321ed501805247932c5b56dab1c3
# Default --query-fasta for blastp (user protein FASTA). Leave empty if unused.
CELL_ANNOTATION_QUERY_FASTA=
